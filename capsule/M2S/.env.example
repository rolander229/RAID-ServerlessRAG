# ============================================================
# Mono2Sls - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# LLM Backend (OpenAI-compatible endpoint)
# ------------------------------------------------------------
# Option A: OpenAI or any compatible proxy
OPENAI_API_BASE='http://192.168.1.248:8080/v1'
OPENAI_API_KEY='sk-123456'
OPENAI_MODEL_NAME=gpt-4o

# Option B: DeepSeek
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_API_KEY=sk-YOUR_DEEPSEEK_KEY
# OPENAI_MODEL_NAME=deepseek-chat

# Option C: Gemini (via LiteLLM proxy or direct)
# GOOGLE_API_KEY=AIza-YOUR_GOOGLE_KEY
# OPENAI_MODEL_NAME=gemini/gemini-2.5-pro

# ------------------------------------------------------------
# Ollama Embedder (used for CrewAI domain-knowledge RAG)
# Requires a locally running Ollama instance with mxbai-embed-large pulled.
# Run: ollama pull mxbai-embed-large
# ------------------------------------------------------------
EMBEDDINGS_OLLAMA_MODEL_NAME=mxbai-embed-large  
EMBEDDINGS_OLLAMA_BASE_URL=http://192.168.5.65:11434

# ------------------------------------------------------------
# Optional: inter-task cooldown to avoid API throttling (seconds)
# Default: 15  Set to 0 to disable.
# ------------------------------------------------------------
# INTER_TASK_COOLDOWN=15
